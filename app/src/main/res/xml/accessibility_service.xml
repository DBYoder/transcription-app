<?xml version="1.0" encoding="utf-8"?>
<!--
    The bubble only needs to know when a text box is focused and where the keyboard is:
    focus and window events, plus permission to look at windows so it can find the
    keyboard and the focused text box. flagInputMethodEditor (Android 13+) lets it type
    the dictation into that text box the way a keyboard does, without the clipboard.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagInputMethodEditor"
    android:canRetrieveWindowContent="true"
    android:description="@string/bubble_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100"
    android:settingsActivity="io.github.dbyoder.transcribe.MainActivity"
    android:summary="@string/bubble_service_summary" />
